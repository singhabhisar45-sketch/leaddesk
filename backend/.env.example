# LeadDesk Mini — Backend Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL connection string (takes priority over individual vars below)
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/leaddesk?sslmode=disable

# OR use individual vars:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=leaddesk
# DB_SSLMODE=disable

# Server port (default: 8080)
PORT=8080

# CORS: set to your deployed Flutter web URL in production
# ALLOWED_ORIGIN=https://your-flutter-app.netlify.app
ALLOWED_ORIGIN=*
